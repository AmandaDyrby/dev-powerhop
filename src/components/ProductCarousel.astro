---
import { Image } from "astro:assets";

// A carousel image can be either an Astro image asset or an external string URL.
interface CarouselImage {
  src: ImageMetadata | string;
  alt: string;
}

interface Props {
  images: CarouselImage[];
}

const { images = [] } = Astro.props;

// Used to hide carousel controls when there is only one product image.
const hasMultipleImages = images.length > 1;
---

<!-- Product image carousel: shows product photos with optional arrows and dots. -->
<section
  class:list={["product-carousel", !hasMultipleImages && "single-image"]}
  aria-label="Product images"
  tabindex="0"
  data-product-carousel
>
  {
    hasMultipleImages && (
      // Previous arrow only appears when there is more than one image.
      <button
        class="carousel-arrow carousel-arrow-left"
        type="button"
        aria-label="Previous product image"
        data-carousel-previous
      />
    )
  }

  <div class="carousel-frame">
    {
      images.length > 0 ? (
        // Render each image, making the first one visible by default.
        images.map((image, index) =>
          typeof image.src === "string" ? (
            <img
              src={image.src}
              alt={image.alt}
              class={`carousel-image ${index === 0 ? "is-active" : ""}`}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              data-carousel-image
            />
          ) : (
            <Image
              src={image.src}
              alt={image.alt}
              class={`carousel-image ${index === 0 ? "is-active" : ""}`}
              width={520}
              data-carousel-image
            />
          ),
        )
      ) : (
        // Fallback message shown when the product has no images yet.
        <div class="carousel-placeholder">Product image coming soon</div>
      )
    }
  </div>

  {
    hasMultipleImages && (
      // Next arrow only appears when there is more than one image.
      <button
        class="carousel-arrow carousel-arrow-right"
        type="button"
        aria-label="Next product image"
        data-carousel-next
      />
    )
  }

  {
    hasMultipleImages && (
      // Dot controls let users jump directly to a specific product image.
      <div class="carousel-dots" aria-label="Choose product image">
        {images.map((_, index) => (
          <button
            class={`carousel-dot ${index === 0 ? "is-active" : ""}`}
            type="button"
            aria-label={`Show product image ${index + 1}`}
            aria-pressed={index === 0 ? "true" : "false"}
            data-carousel-dot
            data-carousel-index={index}
          />
        ))}
      </div>
    )
  }
</section>

<script>
  // Initialize every product carousel on the page.
  document
    .querySelectorAll<HTMLElement>("[data-product-carousel]")
    .forEach((carousel) => {
      // Cache carousel images, controls, and dots for this specific instance.
      const images = Array.from(
        carousel.querySelectorAll<HTMLElement>("[data-carousel-image]"),
      );
      const dots = Array.from(
        carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"),
      );
      const previousButton = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-previous]",
      );
      const nextButton = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-next]",
      );

      let activeIndex = 0;

      // Show the requested image and wrap around at the first/last image.
      const showImage = (nextIndex: number) => {
        if (images.length === 0) {
          return;
        }

        activeIndex = (nextIndex + images.length) % images.length;

        images.forEach((image, index) => {
          image.classList.toggle("is-active", index === activeIndex);
        });

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle("is-active", isActive);
          dot.setAttribute("aria-pressed", String(isActive));
        });
      };

      // Arrow buttons move one image backward or forward.
      previousButton?.addEventListener("click", () =>
        showImage(activeIndex - 1),
      );
      nextButton?.addEventListener("click", () => showImage(activeIndex + 1));

      // Dot buttons jump to the image matching their data index.
      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          showImage(Number(dot.dataset.carouselIndex || 0));
        });
      });

      // Keyboard controls support left/right arrow navigation when focused.
      carousel.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          showImage(activeIndex - 1);
        }

        if (event.key === "ArrowRight") {
          showImage(activeIndex + 1);
        }
      });
    });
</script>

<style>
  /* Carousel shell: center image frame with optional arrows on each side. */
  .product-carousel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    width: min(100%, 24rem);
  }

  /* Single-image products do not reserve columns for hidden arrows. */
  .product-carousel.single-image {
    grid-template-columns: minmax(0, 1fr);
  }

  /* Fixed-ratio image stage that keeps product cards visually consistent. */
  .carousel-frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1.05;
    border: 1px solid #9f9f9f;
    background: #ffffff;
    overflow: hidden;
  }

  /* Placeholder styling for products without image data. */
  .carousel-placeholder {
    width: 86%;
    color: #737373;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 0.9rem;
    line-height: 1.4;
    text-align: center;
    text-transform: uppercase;
  }

  /* Images are stacked in the same frame; only the active one is visible. */
  .carousel-image {
    position: absolute;
    inset: 7%;
    display: block;
    width: 86%;
    height: 86%;
    object-fit: contain;
    opacity: 0;
    z-index: 0;
    transition: opacity 160ms ease;
  }

  /* Active image is brought above the inactive transparent images. */
  .carousel-image.is-active {
    opacity: 1;
    z-index: 1;
  }

  /* Arrow button base shape; the chevron is drawn with the ::before border. */
  .carousel-arrow {
    width: 1.65rem;
    height: 3rem;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  /* Shared chevron shape used by both arrow buttons. */
  .carousel-arrow::before {
    content: "";
    position: absolute;
    inset: 0;
    width: 1.4rem;
    height: 1.4rem;
    margin: auto;
    border-top: 2px solid #111111;
    border-right: 2px solid #111111;
  }

  /* Rotate the shared chevron shape for left and right directions. */
  .carousel-arrow-left::before {
    transform: rotate(-135deg);
  }

  .carousel-arrow-right::before {
    transform: rotate(45deg);
  }

  /* Dot navigation sits below the full carousel width. */
  .carousel-dots {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.75rem;
  }

  /* Inactive dot styling. */
  .carousel-dot {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid #777777;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  /* Active dot uses the brand green to match the visible image. */
  .carousel-dot.is-active {
    border-color: #008751;
    background: #008751;
  }

  /* Accessible focus ring for keyboard users. */
  .carousel-arrow:focus-visible,
  .carousel-dot:focus-visible {
    outline: 2px solid #008751;
    outline-offset: 3px;
  }
</style>
