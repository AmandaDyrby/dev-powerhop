---
import Layout from "../../layouts/Layout.astro";
import ProductCarousel from "../../components/ProductCarousel.astro";
import Button from "../../components/Button.astro";

type Product = {
  id: number;
  modelname: string;
  active: boolean;
  usablepower: number | null;
  surgeprotection: number | null;
  chargingtime: number | null;
  acinputmin: number | null;
  acinputmax: number | null;
  battery: string | null;
  lifespan: number | null;
  inverter: number | null;
  extratraits: string | null;
  price: number | null;
  productdescription: string | null;
  productblurb: string | null;
  specs: string | null;
  "feature-lights": boolean | null;
  "feature-fan": boolean | null;
  "feature-wifi": boolean | null;
  "feature-laptop": boolean | null;
  "feature-tv": boolean | null;
  "feature-phone": boolean | null;
  "feature-sewing": boolean | null;
  "feature-pos": boolean | null;
  "feature-drill": boolean | null;
  "feature-fridge": boolean | null;
  "feature-aircon": boolean | null;
  "feature-freezer": boolean | null;
  "feature-speaker": boolean | null;
  "feature-printer": boolean | null;
  "feature-computer": boolean | null;
  imgfront: string | null;
  imgface: string | null;
  imgback: string | null;
};

const { product } = Astro.props as { product: Product };

const formatNumber = (value: number | null) =>
  value === null ? null : new Intl.NumberFormat("en-US").format(value);

const formatModelName = (modelname: string) => {
  const match = modelname.match(/^powerhop(.+)$/i);

  return match
    ? { prefix: "POWER/HOP", number: match[1] }
    : { prefix: modelname, number: "" };
};

const modelName = formatModelName(product.modelname);

const carouselImages = [
  {
    src: product.imgfront,
    alt: `Front view of ${modelName.prefix}${modelName.number}`,
  },
  {
    src: product.imgface,
    alt: `Face view of ${modelName.prefix}${modelName.number}`,
  },
  {
    src: product.imgback,
    alt: `Back view of ${modelName.prefix}${modelName.number}`,
  },
].filter(
  (image): image is { src: string; alt: string } =>
    typeof image.src === "string" && image.src.trim().length > 0,
);

const productStats = [
  [
    "USABLE POWER",
    product.usablepower === null
      ? null
      : `${formatNumber(product.usablepower)} WH`,
  ],
  [
    "SURGE PROTECT.",
    product.surgeprotection === null
      ? null
      : `${formatNumber(product.surgeprotection)} W`,
  ],
  [
    "CHARGING TIME",
    product.chargingtime === null ? null : `~${product.chargingtime}H`,
  ],
  [
    "AC INPUT",
    product.acinputmin === null || product.acinputmax === null
      ? null
      : `${product.acinputmin}-${product.acinputmax} V`,
  ],
  ["BATTERY", product.battery],
  [
    "LIFESPAN",
    product.lifespan === null
      ? null
      : `${formatNumber(product.lifespan)}+ CYCLES`,
  ],
  [
    "INVERTER",
    product.inverter === null ? null : `${formatNumber(product.inverter)} W`,
  ],
].filter((stat): stat is [string, string] => Boolean(stat[1]));

const extraTraits =
  product.extratraits
    ?.split(",")
    .map((trait) => trait.trim())
    .filter(Boolean) ?? [];

const productFeatures = [
  ["feature-lights", "Lights"],
  ["feature-fan", "Fan"],
  ["feature-wifi", "Wi-Fi"],
  ["feature-laptop", "Laptop"],
  ["feature-tv", "TV"],
  ["feature-phone", "Phone"],
  ["feature-sewing", "Sewing"],
  ["feature-pos", "POS"],
  ["feature-drill", "Drill"],
  ["feature-fridge", "Fridge"],
  ["feature-aircon", "Aircon"],
  ["feature-freezer", "Freezer"],
  ["feature-speaker", "Speaker"],
  ["feature-printer", "Printer"],
  ["feature-computer", "Computer"],
].filter(([featureKey]) => product[featureKey as keyof Product]);

const formattedPrice =
  product.price === null ? null : `\u20a6${formatNumber(product.price)}`;

export async function getStaticPaths() {
  const response = await fetch(
    `${import.meta.env.SUPABASE_URL}/rest/v1/products?select=*&active=eq.true`,
    {
      headers: {
        apikey: import.meta.env.SUPABASE_PUBLISHABLE_KEY,
      },
    },
  );

  if (!response.ok) {
    throw new Error(`Failed to fetch products: ${response.status}`);
  }

  const products = (await response.json()) as Product[];

  return products.map((product) => {
    return {
      params: { modelname: String(product.modelname) },
      props: { product },
    };
  });
}
---

<Layout Page={product.modelname} Title={product.modelname}>
  <section class="product-page">
    <ProductCarousel images={carouselImages} />

    <div class="product-details">
      <h1>{modelName.prefix}<span>{modelName.number}</span></h1>

      <div class="productstatistics">
        {
          productStats.map(([label, value]) => (
            <>
              <p>{label}</p>
              <p>{value}</p>
            </>
          ))
        }
        {
          extraTraits.length > 0 && (
            <div class="extrafeatures">
              {extraTraits.map((trait) => (
                <p>{trait}</p>
              ))}
            </div>
          )
        }
      </div>

      {
        formattedPrice && (
          <div class="productprice">
            <p class="price">{formattedPrice}</p>
            <p class="billing-period">/ MONTH</p>
            <p class="startup-cost">&#8358;0 STARTUP COST</p>
          </div>
        )
      }
    </div>

    {
      product.productdescription && (
        <p class="product-description">{product.productdescription}</p>
      )
    }

    <Button
      href="/booking/"
      variant={3}
      text="GET STARTED ->"
      class="sticky-get-started"
    />

    <section class="power-features">
      <h2>What can I power</h2>
      {product.productblurb && <p>{product.productblurb}</p>}

      <div class="feature-elements">
        {
          productFeatures.map(([, label]) => (
            <div class="feature">
              <span class="feature-icon" aria-hidden="true" />
              <h3>{label}</h3>
            </div>
          ))
        }
      </div>
      <p class="feature-more">...and much more.</p>
    </section>

    {
      product.specs && (
        <details class="specsdropdown">
          <summary>SPECIFICATIONS</summary>
          <p>{product.specs}</p>
        </details>
      )
    }

    <section class="need-more">
      <h2>Need more</h2>
      <p>
        Browse our other PowerHop models, to find the perfect solution for your
        power needs.
      </p>

      <Button href="/services/" variant={1} text="MODELS ->" />
    </section>
  </section>
</Layout>

<style>
  .product-page {
    display: grid;
    gap: 2.5rem;
    align-items: start;
    justify-items: center;
    box-sizing: border-box;
    width: min(100%, 70rem);
    margin: 0 auto;
    padding: 0 10px 5.5rem;
  }

  .product-details {
    width: min(100%, 30rem);
    justify-self: center;
  }

  h1 {
    margin: 0 0 1.25rem;
    color: #111111;
    font-family: "Barlow Condensed", Arial, Helvetica, sans-serif;
    font-size: clamp(2.7rem, 10vw, 4.1rem);
    font-weight: 900;
    line-height: 0.95;
    text-transform: uppercase;
  }

  h1 span {
    color: #008751;
  }

  h2 {
    margin: 0;
    color: #111111;
    font-family: "Barlow Condensed", Arial, Helvetica, sans-serif;
    font-size: clamp(2rem, 8vw, 2.7rem);
    font-weight: 900;
    line-height: 1;
  }

  h2::after {
    content: "?";
    color: #008751;
  }

  .product-description,
  .power-features > p,
  .need-more p {
    width: min(100%, 27rem);
    margin: 0;
    color: #737373;
    font-family: Inter, Arial, Helvetica, sans-serif;
    font-size: 1rem;
    line-height: 1.7;
  }

  .productstatistics {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-top: 1px solid #b5b5b5;
    border-left: 1px solid #b5b5b5;
    background: #ffffff;
  }

  .productstatistics > p,
  .extrafeatures {
    margin: 0;
    border-right: 1px solid #b5b5b5;
    border-bottom: 1px solid #b5b5b5;
    padding: 0.6rem 0.75rem;
    color: #111111;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: clamp(0.86rem, 3vw, 1rem);
    line-height: 1.35;
    text-transform: uppercase;
  }

  .extrafeatures {
    grid-column: 1 / -1;
    min-height: 5.4rem;
  }

  .extrafeatures p {
    margin: 0 0 0.25rem;
  }

  .extrafeatures p:last-child {
    margin-bottom: 0;
  }

  .productprice {
    display: grid;
    justify-items: end;
    margin-top: 1.5rem;
    text-align: right;
  }

  .price {
    margin: 0;
    color: #008751;
    font-family: "Barlow Condensed", Arial, Helvetica, sans-serif;
    font-size: clamp(2.4rem, 10vw, 3.5rem);
    font-weight: 900;
    line-height: 0.9;
  }

  .billing-period,
  .startup-cost {
    margin: 0;
    color: #8a8a8a;
    font-family: "Inter", Arial, Helvetica, sans-serif;
    font-size: clamp(0.9rem, 3vw, 1.1rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .billing-period {
    margin-top: 0.35rem;
  }

  .startup-cost {
    margin-top: 1.35rem;
  }

  :global(.sticky-get-started) {
    position: sticky;
    bottom: 1rem;
    z-index: 50;
    justify-self: center;
    width: min(calc(100% - 2rem), 24rem);
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.18);
  }

  .specsdropdown {
    width: min(100%, 30rem);
    justify-self: center;
  }

  .specsdropdown summary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    background: #000000;
    color: #f2f2f2;
    cursor: pointer;
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.05em;
    list-style: none;
    padding: 0 2.25rem 0 1.25rem;
    text-transform: uppercase;
  }

  .specsdropdown summary::-webkit-details-marker {
    display: none;
  }

  .specsdropdown summary::before,
  .specsdropdown summary::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 1.15rem;
    height: 0.22rem;
    border-radius: 999px;
    background: #f2f2f2;
    transition: transform 150ms ease;
  }

  .specsdropdown summary::before {
    right: 2.85rem;
    transform: translateY(-50%) rotate(45deg);
  }

  .specsdropdown summary::after {
    right: 2.1rem;
    transform: translateY(-50%) rotate(-45deg);
  }

  .specsdropdown[open] summary::before {
    transform: translateY(-50%) rotate(-45deg);
  }

  .specsdropdown[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .specsdropdown p {
    margin: 0;
    background: #1b1b1b;
    color: #f2f2f2;
    font-family: Inter, Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.55;
    padding: 1.6rem 1.8rem 1.75rem;
  }

  .power-features {
    display: grid;
    gap: 1.35rem;
    width: min(100%, 64rem);
    justify-items: center;
    justify-self: center;
    border-top: 1px solid #dddddd;
    padding-top: 2.5rem;
  }

  .power-features h2,
  .power-features > p {
    justify-self: center;
    width: min(100%, 27rem);
  }

  .power-features h2 {
    text-align: center;
  }

  .feature-elements {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.55rem 0.85rem;
    width: min(100%, 26rem);
    justify-items: center;
  }

  .feature {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    min-width: 0;
  }

  .feature-icon {
    display: block;
    width: clamp(4.4rem, 20vw, 5.5rem);
    aspect-ratio: 1;
    border-radius: 999px;
    background: #d9d9d9;
  }

  .feature h3 {
    margin: 0;
    color: #111111;
    font-family: Inter, Arial, Helvetica, sans-serif;
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .feature-more {
    justify-self: center;
    text-align: center;
  }

  .need-more {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    width: min(100%, 27rem);
    margin: 0 auto;
  }

  @media (min-width: 56rem) {
    .product-page {
      grid-template-columns: minmax(0, 34rem) minmax(0, 30rem);
      gap: 2rem 3rem;
      justify-content: center;
      justify-items: stretch;
      align-items: start;
      width: min(calc(100% - 40px), 70rem);
      padding-right: 0;
      padding-left: 0;
    }

    .product-page :global(.product-carousel) {
      grid-column: 1;
      grid-row: 1 / span 3;
      justify-self: center;
      width: min(100%, 34rem);
    }

    .product-details {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
    }

    h1 {
      font-size: clamp(3rem, 5vw, 3.7rem);
      white-space: nowrap;
    }

    .product-description {
      grid-column: 2;
      grid-row: 2;
      width: 100%;
      font-size: 0.82rem;
    }

    :global(.sticky-get-started) {
      grid-column: 2;
      grid-row: 3;
      position: static;
      width: 12.5rem;
      box-shadow: none;
    }

    .specsdropdown {
      grid-column: 1 / -1;
      grid-row: 4;
      width: min(100%, 60rem);
      justify-self: center;
    }

    .specsdropdown summary {
      min-height: 2.9rem;
      font-size: 1rem;
      padding: 0 4rem 0 5rem;
    }

    .specsdropdown summary::after {
      width: 0.95rem;
      height: 0.16rem;
    }

    .specsdropdown summary::before {
      right: 2.65rem;
      width: 0.95rem;
      height: 0.16rem;
    }

    .power-features {
      grid-column: 1 / -1;
      grid-row: 5;
      justify-self: center;
      margin-top: 2rem;
      padding-top: 4rem;
    }

    .power-features > p {
      width: 100%;
      font-size: 0.78rem;
    }

    .feature-elements {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      width: min(100%, 50rem);
      justify-self: center;
      gap: 1.35rem 1rem;
    }

    .feature-icon {
      width: 5rem;
    }

    .feature h3 {
      font-size: 0.72rem;
    }

    .need-more {
      grid-column: 1 / -1;
      grid-row: 6;
      justify-self: center;
    }
  }
</style>
